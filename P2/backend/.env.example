PORT=4000
NODE_ENV=development

# Base de données
MONGO_URI=mongodb://localhost:27017/gandal

# Auth
JWT_SECRET=change_me

# Envoi d'email (code de vérification, notifications) — via Brevo (SMTP)
# Identifiants générés dans app.brevo.com/settings/advanced (SMTP & API)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gandal <no-reply@gandal.example>"

# Hébergement médias (vidéos, supports, images de profil)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CORS_WHITELIST=http://localhost:3000
