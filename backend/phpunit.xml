<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            PostgreSQL, pas SQLite : l'architecture entière (RLS, set_config,
            gen_random_uuid, migrations en SQL brut Postgres) est spécifique
            à Postgres — voir db/README.md et docs/database-schema.md §5.
            SQLite ne supporte pas la Row-Level Security ; y faire tourner
            les tests laisserait le mécanisme d'isolation multi-tenant, qui a
            déjà produit 3 bugs réels, complètement hors de portée des tests.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="ecole_gn_test"/>
        <env name="DB_USERNAME" value="app_ecole_gn"/>
        <env name="DB_PASSWORD" value="test-password"/>
        <!-- Rôle propriétaire pour les migrations de test (jamais
             app_ecole_gn — voir db/README.md). Valeur de dev local ;
             un environnement CI la remplace en exportant un vrai
             DB_MIGRATE_USERNAME avant `phpunit`, qui prend le dessus
             sur ces valeurs par défaut sans "force". -->
        <env name="DB_MIGRATE_USERNAME" value="mohamedbenhussein"/>
        <env name="DB_MIGRATE_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
